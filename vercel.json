{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/cron-keepalive",
      "destination": "/api/cron-keepalive"
    },
    {
      "source": "/api/:path*",
      "destination": "https://aircommand-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-keepalive",
      "schedule": "*/10 * * * *"
    }
  ]
}
